            "body": {
              "mode": "raw",
              "raw": "{\n  \"detalles\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": 3,\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ventas",
              "host": [
